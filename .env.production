# ============================================================================
# BlackSentinel Forge - Production Environment
# ============================================================================

# General
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://forge:CHANGE_ME_STRONG_PASSWORD@postgres:5432/blacksentinel_forge

# Redis
REDIS_URL=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379

# Authentication - CHANGE THESE IN PRODUCTION
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=https://your-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# AI Engine
AI_CONFIDENCE_THRESHOLD=0.7
AI_AUTO_EXECUTE_THRESHOLD=0.9
AI_REQUIRE_APPROVAL_THRESHOLD=80

# Workflow Engine
MAX_CONCURRENT_EXECUTIONS=50
DEFAULT_TIMEOUT=300000
MAX_RETRIES=3

# Connector Service
CONNECTOR_TIMEOUT=30000

# Observability
ENABLE_TRACING=true

# Frontend
NEXT_PUBLIC_API_URL=https://api.your-domain.com
