#!/bin/bash
# ============================================================================
# BlackSentinel Forge - Production Deployment Script
# ============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
ORANGE='\033[0;33m'
NC='\033[0m'

print_banner() {
    echo -e "${ORANGE}"
    echo "  ██████╗ ██╗      ██████╗ ██████╗  █████╗ ███████╗██╗  ██╗███████╗██╗     ██╗     "
    echo "  ██╔══██╗██║     ██╔═══██╗██╔══██╗██╔══██╗██╔════╝██║  ██║██╔════╝██║     ██║     "
    echo "  ██████╔╝██║     ██║   ██║██████╔╝███████║███████╗███████║█████╗  ██║     ██║     "
    echo "  ██╔══██╗██║     ██║   ██║██╔══██╗██╔══██║╚════██║██╔══██║██╔══╝  ██║     ██║     "
    echo "  ██████╔╝███████╗╚██████╔╝██████╔╝██║  ██║███████║██║  ██║███████╗███████╗███████╗"
    echo "  ╚═════╝ ╚══════╝ ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝"
    echo -e "${NC}"
    echo -e "  ${GREEN}Autonomous Security Automation & Orchestration Platform${NC}"
    echo ""
}

show_help() {
    print_banner
    echo "Usage: $0 <command> [options]"
    echo ""
    echo "Commands:"
    echo "  ${GREEN}dev${NC}           Start all services in development mode"
    echo "  ${GREEN}dev:web${NC}       Start only the frontend"
    echo "  ${GREEN}dev:api${NC}       Start only the API gateway"
    echo "  ${GREEN}build${NC}         Build all packages for production"
    echo "  ${GREEN}docker:up${NC}     Start all services via Docker"
    echo "  ${GREEN}docker:down${NC}   Stop all Docker services"
    echo "  ${GREEN}docker:build${NC}  Build all Docker images"
    echo "  ${GREEN}docker:logs${NC}   Tail Docker logs"
    echo "  ${GREEN}db:migrate${NC}    Run database migrations"
    echo "  ${GREEN}db:seed${NC}       Seed database with demo data"
    echo "  ${GREEN}db:reset${NC}      Reset database (drop + migrate + seed)"
    echo "  ${GREEN}test${NC}          Run all tests"
    echo "  ${GREEN}test:watch${NC}    Run tests in watch mode"
    echo "  ${GREEN}lint${NC}          Run linter"
    echo "  ${GREEN}format${NC}        Format code with Prettier"
    echo "  ${GREEN}typecheck${NC}     Run TypeScript type checking"
    echo "  ${GREEN}health${NC}        Check health of all services"
    echo "  ${GREEN}deploy${NC}        Deploy to Kubernetes"
    echo "  ${GREEN}status${NC}        Show deployment status"
    echo "  ${GREEN}clean${NC}         Clean all build artifacts"
    echo "  ${GREEN}help${NC}          Show this help message"
    echo ""
}

cmd_dev() {
    echo -e "${ORANGE}Starting BlackSentinel Forge in development mode...${NC}"
    npm run dev
}

cmd_dev_web() {
    echo -e "${ORANGE}Starting Frontend...${NC}"
    npm run dev:web
}

cmd_dev_api() {
    echo -e "${ORANGE}Starting API Gateway...${NC}"
    npm run dev:api
}

cmd_build() {
    echo -e "${ORANGE}Building all packages...${NC}"
    npm run build
    echo -e "${GREEN}Build complete!${NC}"
}

cmd_docker_up() {
    echo -e "${ORANGE}Starting Docker services...${NC}"
    cd infrastructure/docker
    docker-compose up -d
    echo -e "${GREEN}Services started!${NC}"
    echo ""
    echo "  Frontend:      http://localhost:3000"
    echo "  API Gateway:   http://localhost:8080"
    echo "  Health Check:  http://localhost:8080/health"
    echo ""
}

cmd_docker_down() {
    echo -e "${ORANGE}Stopping Docker services...${NC}"
    cd infrastructure/docker
    docker-compose down
    echo -e "${GREEN}Services stopped!${NC}"
}

cmd_docker_build() {
    echo -e "${ORANGE}Building Docker images...${NC}"
    cd infrastructure/docker
    docker-compose build --no-cache
    echo -e "${GREEN}Images built!${NC}"
}

cmd_docker_logs() {
    cd infrastructure/docker
    docker-compose logs -f --tail=100
}

cmd_db_migrate() {
    echo -e "${ORANGE}Running database migrations...${NC}"
    npm run db:migrate
    echo -e "${GREEN}Migrations complete!${NC}"
}

cmd_db_seed() {
    echo -e "${ORANGE}Seeding database...${NC}"
    npm run db:seed
    echo -e "${GREEN}Database seeded!${NC}"
}

cmd_db_reset() {
    echo -e "${YELLOW}Resetting database (drop + migrate + seed)...${NC}"
    cd services/api-gateway
    npx prisma migrate reset --force
    cd ../..
    npm run db:migrate
    npm run db:seed
    echo -e "${GREEN}Database reset complete!${NC}"
}

cmd_test() {
    echo -e "${ORANGE}Running tests...${NC}"
    npm run test
}

cmd_test_watch() {
    echo -e "${ORANGE}Running tests in watch mode...${NC}"
    npm run test:watch
}

cmd_lint() {
    echo -e "${ORANGE}Running linter...${NC}"
    npm run lint
}

cmd_format() {
    echo -e "${ORANGE}Formatting code...${NC}"
    npm run format
    echo -e "${GREEN}Code formatted!${NC}"
}

cmd_typecheck() {
    echo -e "${ORANGE}Running type checking...${NC}"
    npm run typecheck
    echo -e "${GREEN}Type checking passed!${NC}"
}

cmd_health() {
    echo -e "${ORANGE}Checking service health...${NC}"
    echo ""

    # API Gateway
    if curl -s http://localhost:8080/health > /dev/null 2>&1; then
        echo -e "  ${GREEN}[OK]${NC} API Gateway    (port 8080)"
    else
        echo -e "  ${RED}[FAIL]${NC} API Gateway    (port 8080) - NOT RUNNING"
    fi

    # Frontend
    if curl -s http://localhost:3000 > /dev/null 2>&1; then
        echo -e "  ${GREEN}[OK]${NC} Frontend       (port 3000)"
    else
        echo -e "  ${RED}[FAIL]${NC} Frontend       (port 3000) - NOT RUNNING"
    fi

    # PostgreSQL
    if pg_isready -h localhost -p 5432 > /dev/null 2>&1; then
        echo -e "  ${GREEN}[OK]${NC} PostgreSQL     (port 5432)"
    else
        echo -e "  ${RED}[FAIL]${NC} PostgreSQL     (port 5432) - NOT RUNNING"
    fi

    # Redis
    if redis-cli ping > /dev/null 2>&1; then
        echo -e "  ${GREEN}[OK]${NC} Redis          (port 6379)"
    else
        echo -e "  ${RED}[FAIL]${NC} Redis          (port 6379) - NOT RUNNING"
    fi

    echo ""
}

cmd_deploy() {
    echo -e "${ORANGE}Deploying to Kubernetes...${NC}"
    kubectl apply -f infrastructure/kubernetes/namespace.yaml
    kubectl apply -f infrastructure/kubernetes/secrets.yaml
    kubectl apply -f infrastructure/kubernetes/configmap.yaml
    kubectl apply -f infrastructure/kubernetes/
    echo -e "${GREEN}Deployment complete!${NC}"
}

cmd_status() {
    echo -e "${ORANGE}Deployment Status:${NC}"
    echo ""
    kubectl get pods -n blacksentinel-forge 2>/dev/null || echo "  Kubernetes not available locally"
    echo ""
    docker ps --filter "name=forge-" --format "  {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || echo "  Docker not running"
}

cmd_clean() {
    echo -e "${YELLOW}Cleaning build artifacts...${NC}"
    npm run clean
    npm run clean:build
    echo -e "${GREEN}Clean complete!${NC}"
}

# Main
case "${1:-help}" in
    dev)          cmd_dev ;;
    dev:web)      cmd_dev_web ;;
    dev:api)      cmd_dev_api ;;
    build)        cmd_build ;;
    docker:up)    cmd_docker_up ;;
    docker:down)  cmd_docker_down ;;
    docker:build) cmd_docker_build ;;
    docker:logs)  cmd_docker_logs ;;
    db:migrate)   cmd_db_migrate ;;
    db:seed)      cmd_db_seed ;;
    db:reset)     cmd_db_reset ;;
    test)         cmd_test ;;
    test:watch)   cmd_test_watch ;;
    lint)         cmd_lint ;;
    format)       cmd_format ;;
    typecheck)    cmd_typecheck ;;
    health)       cmd_health ;;
    deploy)       cmd_deploy ;;
    status)       cmd_status ;;
    clean)        cmd_clean ;;
    help|*)       show_help ;;
esac
