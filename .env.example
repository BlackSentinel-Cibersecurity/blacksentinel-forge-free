# ============================================================================
# BlackSentinel Forge - Environment Variables
# ============================================================================

# General
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://forge:forge_dev_password@localhost:5432/blacksentinel_forge

# Redis
REDIS_URL=redis://:forge_dev_password@localhost:6379

# Authentication
JWT_SECRET=forge_dev_jwt_secret_change_in_production
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# AI Engine
AI_CONFIDENCE_THRESHOLD=0.7
AI_AUTO_EXECUTE_THRESHOLD=0.9
AI_REQUIRE_APPROVAL_THRESHOLD=80

# Workflow Engine
MAX_CONCURRENT_EXECUTIONS=50
DEFAULT_TIMEOUT=300000
MAX_RETRIES=3
BACKOFF_MS=1000
BACKOFF_MULTIPLIER=2

# Connector Service
CONNECTOR_TIMEOUT=30000
CONNECTOR_MAX_RETRIES=3

# Observability
ENABLE_TRACING=true
TRACE_SAMPLE_RATE=0.1

# Secrets (BlackSentinel Vault)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-token

# External Services (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# CROWDSTRIKE_CLIENT_ID=
# CROWDSTRIKE_CLIENT_SECRET=
# SERVICENOW_INSTANCE=
# SERVICENOW_USERNAME=
# SERVICENOW_PASSWORD=
# SLACK_BOT_TOKEN=
# SPLUNK_HEC_TOKEN=
# SPLUNK_HEC_URL=
